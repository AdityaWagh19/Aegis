# Groq API
# Model IDs verified against live Groq catalog 2026-08-24.
# Original plan IDs (llama-3.3-70b-versatile / llama-3.1-8b-instant /
# mixtral-8x7b-32768) no longer exist on Groq.
GROQ_API_KEY=
GROQ_API_KEY_FALLBACK=
GROQ_MODEL_TIER2=openai/gpt-oss-120b
GROQ_MODEL_TIER2_FAST=openai/gpt-oss-20b
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b

# Razorpay (Test Mode ONLY — rzp_test_* keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Database
DB_PASSWORD=
DATABASE_URL=sqlite+aiosqlite:///./aegis.db

# Application
SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Phase 9 — Multi-tenancy + encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AEGIS_MASTER_ENCRYPTION_KEY=

# Phase 9 — Redis (job queue + rate limiter)
REDIS_URL=redis://localhost:6379

# Phase 9 — Observability
PROMETHEUS_ENABLED=true
